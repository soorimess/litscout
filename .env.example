# OpenAI-compatible provider for chat and embeddings
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Topic mode: size of the candidate pool the LLM picks seeds from
SEED_POOL_MAX=200

# Optional source keys and polite-pool contact
OPENALEX_API_KEY=
S2_API_KEY=
CONTACT_EMAIL=

# Budget caps per run
MAX_PAPERS=100000
MAX_COST_USD=20

# Optional password for `litscout dashboard` (user name: review)
DASHBOARD_PASSWORD=
