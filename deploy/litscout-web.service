[Unit]
Description=LitScout web app (API, job runner, frontend)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/litscout
ExecStart=/opt/litscout/.venv/bin/uvicorn app.main:app_factory --factory --app-dir backend --host 0.0.0.0 --port 8080
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
# Review jobs run as their own processes; restarting the web app must not stop them.
KillMode=process

[Install]
WantedBy=multi-user.target
